{
  "name": "@acteon/client",
  "version": "0.1.0",
  "description": "Node.js/TypeScript client for the Acteon action gateway",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "package:check": "node scripts/check-package.mjs"
  },
  "keywords": [
    "acteon",
    "action",
    "gateway",
    "api",
    "client"
  ],
  "author": "Renzo C. Sanchez-Silva",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/penserai/acteon.git",
    "directory": "clients/nodejs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.3"
  }
}
